{
  "schemaVersion": 1,
  "id": "capecreator",
  "version": "${version}",
  "name": "Cape Creator",
  "description": "Design your own cape in an in-game pixel editor and wear it.",
  "authors": ["Adhrit"],
  "license": "MIT",
  "icon": "assets/capecreator/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.adhrit.capecreator.CapeCreatorClient"]
  },
  "mixins": ["capecreator.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
