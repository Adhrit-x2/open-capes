{
  "schemaVersion": 1,
  "id": "capecreator",
  "version": "${version}",
  "name": "Open Capes",
  "description": "Design your own cape in an in-game pixel editor and wear it.",
  "authors": ["Adhrit"],
  "license": "MIT",
  "icon": "assets/capecreator/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.adhrit.capecreator.CapeCreatorClient"]
  },
  "mixins": ["capecreator.mixins.json"],
  "depends": {
    "fabricloader": ">=${minLoader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": ">=${minFabricApi}"
  }
}
